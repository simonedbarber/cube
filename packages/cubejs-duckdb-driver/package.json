{
  "name": "@cubejs-backend/duckdb-driver",
  "description": "Cube DuckDB database driver",
  "author": "Cube Dev, Inc.",
  "version": "1.7.42",
  "repository": {
    "type": "git",
    "url": "https://github.com/cube-js/cube.git",
    "directory": "packages/cubejs-duckdb-driver"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/src",
    "index.js"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && npm run tsc",
    "tsc": "tsc",
    "watch": "tsc -w",
    "unit": "NODE_OPTIONS=--experimental-vm-modules jest --verbose dist/test/unit",
    "unit:semantic-sql": "CUBESQL_STREAM_MODE=true NODE_OPTIONS=--experimental-vm-modules jest --verbose dist/test/semantic-sql"
  },
  "dependencies": {
    "@cubejs-backend/base-driver": "1.7.42",
    "@cubejs-backend/schema-compiler": "1.7.42",
    "@cubejs-backend/shared": "1.7.42",
    "@duckdb/node-api": "1.5.5-r.5",
    "luxon": "^3.4.4"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@cubejs-backend/api-gateway": "1.7.42",
    "@cubejs-backend/linter": "1.7.42",
    "@cubejs-backend/postgres-driver": "1.7.42",
    "@cubejs-backend/query-orchestrator": "1.7.42",
    "@cubejs-backend/server-core": "1.7.42",
    "@cubejs-backend/testing-shared": "1.7.42",
    "@types/express": "^4.17.21",
    "@types/jest": "^29",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22",
    "express": "^4.22.2",
    "jest": "^29",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
